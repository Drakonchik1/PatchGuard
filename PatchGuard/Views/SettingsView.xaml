<UserControl x:Class="PatchGuard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PatchGuard.Controls"
             xmlns:conv="clr-namespace:PatchGuard.Converters"
             xmlns:vm="clr-namespace:PatchGuard.ViewModels">
    <UserControl.Resources>
        <conv:StringEqualsConverter x:Key="StrEq"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="Settings"
                             Eyebrow="PREFERENCES"
                             Subtitle="Choose how AI guidance runs, then review recent council session metrics (aggregates only — no raw prompts)."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="AI chat provider"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Provider choice is in %LocalAppData%\PatchGuard\user-settings.json. API keys use Windows DPAPI under secrets\ — never plain JSON."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,18"
                                   TextWrapping="Wrap"/>

                        <RadioButton GroupName="ChatProvider"
                                     Content="Cloud (OpenAI)"
                                     Margin="0,0,0,10"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     IsChecked="{Binding SelectedChatProvider, Converter={StaticResource StrEq}, ConverterParameter=OpenAI, Mode=TwoWay}"
                                     AutomationProperties.Name="Use Cloud OpenAI chat provider"/>
                        <RadioButton GroupName="ChatProvider"
                                     Content="Azure OpenAI"
                                     Margin="0,0,0,10"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     IsChecked="{Binding SelectedChatProvider, Converter={StaticResource StrEq}, ConverterParameter=Azure, Mode=TwoWay}"
                                     AutomationProperties.Name="Use Azure OpenAI chat provider"/>
                        <RadioButton GroupName="ChatProvider"
                                     Content="Ollama (local LLM)"
                                     Margin="0,0,0,10"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     IsChecked="{Binding SelectedChatProvider, Converter={StaticResource StrEq}, ConverterParameter=Ollama, Mode=TwoWay}"
                                     AutomationProperties.Name="Use Ollama local chat provider"/>
                        <RadioButton GroupName="ChatProvider"
                                     Content="Rules (no LLM)"
                                     Margin="0,0,0,14"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     IsChecked="{Binding SelectedChatProvider, Converter={StaticResource StrEq}, ConverterParameter=Rules, Mode=TwoWay}"
                                     AutomationProperties.Name="Use Rules only council"/>

                        <TextBlock Text="{Binding ProviderStatus}"
                                   Style="{StaticResource SubtleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsAzurePanelVisible, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Azure OpenAI"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,8,0,8"/>
                            <TextBlock Text="Endpoint"
                                       Style="{StaticResource SubtleText}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AzureEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Azure OpenAI endpoint"/>
                            <TextBlock Text="Deployment name"
                                       Style="{StaticResource SubtleText}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AzureDeployment, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Azure OpenAI deployment"/>
                            <TextBlock Text="API key (leave blank to keep existing DPAPI secret)"
                                       Style="{StaticResource SubtleText}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AzureApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Azure OpenAI API key"/>
                            <Button Content="Save Azure settings"
                                    Command="{Binding SaveAzureSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,8"
                                    Padding="12,6"
                                    AutomationProperties.Name="Save Azure OpenAI settings"/>
                            <TextBlock Text="{Binding AzureSecretStatus}"
                                       Style="{StaticResource SubtleText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Last 10 AI sessions"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Each entry shows scenario, source, latency, and evaluation scores."
                                   Style="{StaticResource SubtleText}"
                                   Margin="0,0,0,18"/>

                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InsetStatTile}"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Scenario}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding EvaluatedAt, StringFormat={}{0:g}}"
                                                           Style="{StaticResource SubtleText}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Source}"
                                                       Style="{StaticResource MetricValue}"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding LatencyMs, StringFormat={}{0} ms}"
                                                       Style="{StaticResource MetricValue}"
                                                       HorizontalAlignment="Left"/>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="{Binding ActionabilityScore, StringFormat=Act {0:F1}%}"
                                                           Style="{StaticResource MetricValue}"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ConsistencyScore, StringFormat=Cons {0:F1}%}"
                                                           Style="{StaticResource SubtleText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentSessions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Run AI guidance once to start collecting baseline sessions."
                                       Style="{StaticResource SubtleText}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
