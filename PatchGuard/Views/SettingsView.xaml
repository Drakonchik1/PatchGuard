<UserControl x:Class="PatchGuard.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PatchGuard.Controls">
    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="Settings"
                             Eyebrow="AI LEARNING"
                             Subtitle="Recent council sessions are stored as aggregate metrics only, so you can compare AI behavior over time without saving raw prompts or private scan text."/>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Last 10 AI sessions"
                           Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Each entry shows scenario, source, latency, and evaluation scores."
                           Style="{StaticResource SubtleText}"
                           Margin="0,0,0,18"/>

                <ItemsControl ItemsSource="{Binding RecentSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InsetStatTile}"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Scenario}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding EvaluatedAt, StringFormat={}{0:g}}"
                                                   Style="{StaticResource SubtleText}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Source}"
                                               Style="{StaticResource MetricValue}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding LatencyMs, StringFormat={}{0} ms}"
                                               Style="{StaticResource MetricValue}"
                                               HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding ActionabilityScore, StringFormat=Act {0:F1}%}"
                                                   Style="{StaticResource MetricValue}"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding ConsistencyScore, StringFormat=Cons {0:F1}%}"
                                                   Style="{StaticResource SubtleText}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRecentSessions}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Run AI guidance once to start collecting baseline sessions."
                               Style="{StaticResource SubtleText}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
