<UserControl x:Class="PatchGuard.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PatchGuard.Controls"
             xmlns:conv="clr-namespace:PatchGuard.Converters"
             xmlns:vm="clr-namespace:PatchGuard.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
        <conv:AlertSeverityToBrushConverter x:Key="AlertSeverityBrush"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <controls:PageHeader Title="Alerts"
                                 Eyebrow="THRESHOLDS"
                                 Subtitle="{Binding SummaryText}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Open Live Monitor"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenMonitorCommand}"
                        Margin="0,0,12,0"
                        AutomationProperties.Name="Open Live Monitor"/>
                <Button Content="Refresh"
                        Style="{StaticResource PrimaryButtonInteractive}"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        AutomationProperties.Name="Refresh alerts"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource WarnBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullVis}}"/>

                <Border Style="{StaticResource EmptyStateCard}"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVis}}"
                        AutomationProperties.Name="No alerts">
                    <StackPanel>
                        <TextBlock Text="All clear" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="CPU/GPU temperature and load thresholds are within limits on the latest snapshot."
                                   Style="{StaticResource SubtleText}"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasActiveAlerts, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Active" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlertDisplayItem}">
                                <Border Style="{StaticResource CardBorder}"
                                        BorderThickness="4,0,0,0"
                                        BorderBrush="{Binding Severity, Converter={StaticResource AlertSeverityBrush}}"
                                        AutomationProperties.Name="{Binding Message}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Margin="0,0,140,0">
                                                <TextBlock Text="{Binding Message}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Metric}"
                                                           Style="{StaticResource MetricLabel}"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Border Background="{StaticResource InsetBackgroundBrush}"
                                                        CornerRadius="4"
                                                        Padding="10,4"
                                                        Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding SeverityLabel}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource AlertSeverityBrush}}"/>
                                                </Border>
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource MetricLabel}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ValueText}"
                                                   Style="{StaticResource SubtleText}"
                                                   Margin="0,0,0,8"/>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="{Binding RecommendedAction}"
                                                       Style="{StaticResource SubtleText}"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Style="{StaticResource MetricLabel}"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,24,0,0"
                            Visibility="{Binding HasResolvedAlerts, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Recently resolved" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding ResolvedAlerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlertDisplayItem}">
                                <Border Style="{StaticResource CardBorder}" Opacity="0.85"
                                        AutomationProperties.Name="{Binding Message}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Message}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RecommendedAction}"
                                                       Style="{StaticResource SubtleText}"
                                                       Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Style="{StaticResource MetricLabel}"
                                                       Margin="0,8,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding SeverityLabel}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource AlertSeverityBrush}}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="Resolved"
                                                       Style="{StaticResource MetricLabel}"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
